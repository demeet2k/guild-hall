{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "guild-hall://alchemy/capability-ir/v0",
  "title": "AZOTH Capability IR V0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "goal_id",
    "goal_text",
    "target",
    "capabilities",
    "constraints",
    "success_tests",
    "resources",
    "risks",
    "contradictions",
    "unknowns",
    "evidence",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "CapabilityIR.V0"},
    "goal_id": {"type": "string", "pattern": "^capir-[0-9a-f]{16}$"},
    "goal_text": {"type": "string", "minLength": 3},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "domain_hint", "standing"],
      "properties": {
        "summary": {"type": "string", "minLength": 3},
        "domain_hint": {"enum": ["general", "software", "data", "biology", "finance", "robotics", "physics"]},
        "standing": {"enum": ["PARSED", "HEURISTIC"]}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verb", "object", "source_clause", "standing"],
        "properties": {
          "verb": {"type": "string", "minLength": 2},
          "object": {"type": "string", "minLength": 1},
          "source_clause": {"type": "string", "minLength": 1},
          "standing": {"enum": ["LEXICALLY_EXTRACTED", "FALLBACK_UNRESOLVED"]}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text", "source_clause"],
        "properties": {
          "kind": {"enum": ["REQUIREMENT", "PROHIBITION", "LIMIT"]},
          "text": {"type": "string", "minLength": 1},
          "source_clause": {"type": "string", "minLength": 1}
        }
      }
    },
    "success_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "source_clause"],
        "properties": {
          "kind": {"const": "MENTIONED"},
          "name": {"type": "string", "minLength": 1},
          "source_clause": {"type": "string", "minLength": 1}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "unknowns": {"type": "array", "items": {"type": "string", "minLength": 3}, "uniqueItems": true},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standing", "observations"],
      "properties": {
        "standing": {"const": "PARSED_NOT_OBSERVED"},
        "observations": {"type": "array", "maxItems": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler", "compiler_version", "input_sha256", "extraction_law"],
      "properties": {
        "compiler": {"const": "guild-hall.capability-ir"},
        "compiler_version": {"const": "0.1.0"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "extraction_law": {"const": "LEXICAL_EXTRACTION_WITH_EXPLICIT_UNRESOLVED_FALLBACK"}
      }
    }
  }
}
