{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athenachka.local/schemas/contradiction-packet.schema.json",
  "title": "ContradictionPacket",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "contradiction_id",
    "cycle_id",
    "parent_act_id",
    "route_address",
    "proposition_a_ref",
    "proposition_b_ref",
    "proposition_a_warrant",
    "proposition_b_warrant",
    "contradiction_classes",
    "witness_refs",
    "candidate_repairs",
    "packet_hash"
  ],
  "properties": {
    "schema_version": {"const": "CONTRADICTION_PACKET/1"},
    "contradiction_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "parent_act_id": {"type": "string", "minLength": 1},
    "route_address": {"type": "string", "minLength": 1},
    "proposition_a_ref": {"type": "string", "minLength": 1},
    "proposition_b_ref": {"type": "string", "minLength": 1},
    "proposition_a_warrant": {"type": "string", "minLength": 1},
    "proposition_b_warrant": {"type": "string", "minLength": 1},
    "contradiction_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "witness_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "counterwitness_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "candidate_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["residual_code", "damaged_layer", "operation"],
        "properties": {
          "residual_code": {"type": "string"},
          "damaged_layer": {"type": "string"},
          "operation": {"type": "string"}
        }
      }
    },
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

