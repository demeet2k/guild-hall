{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/demeet2k/guild-hall/schemas/athena_synapse_node_manifest_v1.schema.json",
  "title": "ATHENA Synapse Node Manifest V1",
  "type": "object",
  "required": [
    "schema", "node_id", "repository", "default_branch", "role", "standing",
    "observed_revision", "native_surfaces", "synapse_profiles", "import_profiles",
    "return_routes", "authority_class", "truth_ceiling", "evidence_refs", "residuals"
  ],
  "properties": {
    "schema": {"const": "ATHENA.SYNAPSE.NODE.MANIFEST.V1"},
    "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "default_branch": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "standing": {"enum": ["DECLARED_NO_ADAPTER", "PROPOSED_ADAPTER", "ACTIVE_ADAPTER", "HOLD"]},
    "observed_revision": {"type": "string", "minLength": 7},
    "native_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["surface_id", "kind", "reference", "mutation_class", "evidence_ref"],
        "properties": {
          "surface_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["MCP_RESOURCE", "MCP_TOOL_MODULE", "STATE_SURFACE", "PROTOCOL", "DATA", "OTHER"]},
          "reference": {"type": "string", "minLength": 1},
          "mutation_class": {"enum": ["READ_ONLY", "READ_WRITE", "MIXED", "UNKNOWN"]},
          "evidence_ref": {"type": "string", "minLength": 1},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "synapse_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "import_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "return_routes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_class": {"type": "string", "minLength": 1},
    "truth_ceiling": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "residuals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"standing": {"const": "DECLARED_NO_ADAPTER"}}},
      "then": {
        "properties": {
          "synapse_profiles": {"maxItems": 0},
          "import_profiles": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"standing": {"enum": ["PROPOSED_ADAPTER", "ACTIVE_ADAPTER"]}}},
      "then": {"properties": {"synapse_profiles": {"minItems": 1}}}
    }
  ],
  "additionalProperties": false
}
