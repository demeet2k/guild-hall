{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/compiled-query-v4.schema.json",
  "title": "KC144 compiled H06 query",
  "type": "object",
  "required": [
    "schema",
    "status",
    "query",
    "crystal_digest",
    "base_graph_mutated",
    "evidence_overlay_mutated",
    "evidence_eligible",
    "semantic_candidates",
    "pareto_frontier_size",
    "selected",
    "refusal",
    "ranking_law",
    "truth_effect",
    "result_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.CompiledQuery.V4"},
    "status": {"enum": ["COMPILED", "REFUSED"]},
    "query": {"$ref": "query-bundle-v4.schema.json"},
    "crystal_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "base_graph_mutated": {"const": false},
    "evidence_overlay_mutated": {"const": false},
    "evidence_eligible": {"type": "integer", "minimum": 0, "maximum": 144},
    "semantic_candidates": {"type": "integer", "minimum": 0, "maximum": 144},
    "pareto_frontier_size": {"type": "integer", "minimum": 0, "maximum": 144},
    "selected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gid",
          "station",
          "band",
          "rank_vector",
          "forward_route",
          "return_plan",
          "open_bridge_ids",
          "route_standing",
          "promotion_effect"
        ],
        "properties": {
          "gid": {"type": "integer", "minimum": 1, "maximum": 144},
          "station": {"type": "string"},
          "band": {"type": "string"},
          "rank_vector": {
            "type": "object",
            "required": [
              "goal_hits",
              "term_hits",
              "operator_hits",
              "invariant_hits",
              "boundary_hits",
              "distance"
            ]
          },
          "forward_route": {
            "type": "object",
            "required": ["path", "segments", "hops"]
          },
          "return_plan": {
            "type": "object",
            "required": ["mode", "path", "segments", "standing", "open_bridge_ids"]
          },
          "open_bridge_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^BR[0-9]{3}$"}
          },
          "route_standing": {
            "enum": [
              "STRUCTURAL_ROUTE",
              "DECLARED_ROUTE_WITH_OPEN_TRANSPORT_CERTIFICATION"
            ]
          },
          "promotion_effect": {"const": "NONE"}
        }
      }
    },
    "refusal": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "detail"],
          "properties": {
            "code": {"type": "string"},
            "detail": {"type": "string"}
          }
        }
      ]
    },
    "ranking_law": {"type": "string", "minLength": 1},
    "truth_effect": {"const": "NONE"},
    "result_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
