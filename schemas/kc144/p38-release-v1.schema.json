{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.invalid/schemas/p38-release-v1.schema.json",
  "title": "KC144 P38 Meta Navigator V2 Candidate Release V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "status",
    "implementation",
    "public_parent",
    "source_sibling",
    "reconciliation_digest",
    "source_capsule_digest",
    "contract_digest",
    "registry_binding_digest",
    "registry_binding_state",
    "coordinate_tensor_digest",
    "query_digest",
    "source_routing_digest",
    "second_edge_digest",
    "calibration_digest",
    "envelope_digest",
    "verification_verdict",
    "proposal_edges_executed",
    "canonical_edges_executed",
    "held_out_outcomes",
    "independent_ic10_returns",
    "production_authority",
    "truth_effect",
    "next_seed",
    "release_digest",
    "result_id"
  ],
  "properties": {
    "schema": {"const": "KC144.P38.Release.V1"},
    "release_id": {"const": "KC144_P38_META_NAVIGATOR_V2_CANDIDATE_V1"},
    "status": {"const": "CANDIDATE_HOLD"},
    "implementation": {
      "type": "object",
      "required": ["repository", "commit", "tree"]
    },
    "public_parent": {"type": "string", "minLength": 1},
    "source_sibling": {"type": "string", "minLength": 1},
    "reconciliation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_capsule_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registry_binding_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "registry_binding_state": {"enum": ["EXPECTED_EXACT_BYTES", "EXACT_BYTES_VERIFIED"]},
    "coordinate_tensor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "query_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_routing_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "second_edge_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "calibration_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "envelope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "verification_verdict": {"const": "PASS"},
    "proposal_edges_executed": {"enum": [0, 1]},
    "canonical_edges_executed": {"const": 0},
    "held_out_outcomes": {"const": 0},
    "independent_ic10_returns": {"const": 0},
    "production_authority": {"const": "HOLD"},
    "truth_effect": {"const": "NONE"},
    "next_seed": {"type": "string", "minLength": 1},
    "release_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "result_id": {"type": "string", "pattern": "^KC144\\.P38\\.CANDIDATE::[0-9a-f]{24}$"}
  }
}
