{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/p42-macrocycle-v1.schema.json",
  "title": "KC144 P42 Macrocycle V1",
  "type": "object",
  "required": ["schema", "contract_digest", "lane_receipts", "state", "envelope_digest"],
  "properties": {
    "schema": {"const": "KC144.P42.Macrocycle.V1"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lane_receipts": {"type": "array", "minItems": 10, "maxItems": 10},
    "state": {"type": "object"},
    "envelope_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
