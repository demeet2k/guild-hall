{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/agent-task-result-v1.schema.json",
  "title": "KC144 content-addressed isolated task result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "run_id", "plan_digest", "work_id", "task_id", "attempt",
    "lease_id", "input_manifest_digest", "status", "claims", "artifacts",
    "checks", "failure", "executor", "truth_effect", "result_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.AgentTaskResult.V1"},
    "run_id": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "work_id": {"$ref": "#/$defs/digest"},
    "task_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "lease_id": {"$ref": "#/$defs/digest"},
    "input_manifest_digest": {"$ref": "#/$defs/digest"},
    "status": {
      "enum": ["SUCCESS", "NO_CHANGE", "BLOCKED", "RETRYABLE_FAILURE", "PERMANENT_FAILURE"]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_key", "evidence_ref"],
        "properties": {
          "claim_key": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "artifact_key", "destination", "semantic_write_key", "media_type",
          "base_digest", "content_digest", "byte_length"
        ],
        "properties": {
          "artifact_key": {"type": "string", "minLength": 1},
          "destination": {"type": "string", "minLength": 1},
          "semantic_write_key": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "base_digest": {"$ref": "#/$defs/digest"},
          "content_digest": {"$ref": "#/$defs/digest"},
          "byte_length": {"type": "integer", "minimum": 0}
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check_id", "status", "evidence_digest"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "evidence_digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "failure": {"type": ["object", "null"]},
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "independent_agent"],
      "properties": {
        "kind": {"const": "LOCAL_DETERMINISTIC_SIMULATION"},
        "independent_agent": {"const": false}
      }
    },
    "truth_effect": {"const": "NONE"},
    "result_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
