{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/agent-run-receipt-bundle-v1.schema.json",
  "title": "KC144 complete content-addressed agent-run receipt bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "lookup_key", "parent_lookup_key", "coordinate_binding",
    "source_snapshot", "plan", "leases", "results", "receipts",
    "audit_events", "manifest", "tool_descriptor",
    "canonical_telemetry_exclusions", "base_graph_mutated",
    "content_transport_certified", "governance_authority_granted",
    "production_truth_effect", "bundle_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.AgentRunReceiptBundle.V1"},
    "lookup_key": {"const": "KC144.V1::CONTENT_ADDRESSED_AGENT_RUN_RECEIPTS"},
    "parent_lookup_key": {"const": "KC144.V1::PARALLEL_ROUTE_CRYSTAL"},
    "coordinate_binding": {"type": "object"},
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "lookup_key", "crystal_digest"],
      "properties": {
        "schema": {"const": "KC144.ParallelRouteCrystal.V1"},
        "lookup_key": {"const": "KC144.V1::PARALLEL_ROUTE_CRYSTAL"},
        "crystal_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "plan": {"$ref": "agent-run-plan-v1.schema.json"},
    "leases": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "agent-lease-v1.schema.json"}
    },
    "results": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "agent-task-result-v1.schema.json"}
    },
    "receipts": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "agent-run-receipt-v1.schema.json"}
    },
    "audit_events": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "agent-run-event-v1.schema.json"}
    },
    "manifest": {"$ref": "agent-run-manifest-v1.schema.json"},
    "tool_descriptor": {"$ref": "mycelium-tool-descriptor-v1.schema.json"},
    "canonical_telemetry_exclusions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string"}
    },
    "base_graph_mutated": {"const": false},
    "content_transport_certified": {"const": false},
    "governance_authority_granted": {"const": false},
    "production_truth_effect": {"const": "NONE"},
    "bundle_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
