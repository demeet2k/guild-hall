{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/governance-ceremony-runtime-state-v10.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "release", "parent_release", "ceremony_id",
    "ceremony_contract_digest", "ratification_contract_digest",
    "plan_digest", "internal_readiness", "filled_seats", "required_seats",
    "barrier", "governance_activated", "production_certificate_issued",
    "production_truth_effect", "frozen_crystal_mutated", "next_seed",
    "runtime_state_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.GovernanceCeremonyRuntimeState.V10"},
    "release": {"const": "KC144.GOVERNANCE.CEREMONY.RUNTIME.V10"},
    "parent_release": {"const": "KC144.EXTERNAL.HANDOFF.RUNTIME.V9"},
    "ceremony_id": {"const": "KC144.GOVERNANCE.CEREMONY.V10"},
    "ceremony_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ratification_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "internal_readiness": {"type": "object"},
    "filled_seats": {"const": 0},
    "required_seats": {"const": 5},
    "barrier": {"const": "FIVE_INDEPENDENT_PARTICIPANT_RESPONSES_REQUIRED"},
    "governance_activated": {"const": false},
    "production_certificate_issued": {"type": "boolean"},
    "production_truth_effect": {"const": "NONE"},
    "frozen_crystal_mutated": {"const": false},
    "next_seed": {"const": "KC144.V10::ISSUE-FIVE-ROLE-BOUND-CHALLENGES"},
    "runtime_state_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
