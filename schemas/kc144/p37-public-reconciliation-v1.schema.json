{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.invalid/schemas/p37-public-reconciliation-v1.schema.json",
  "title": "KC144 P37 Public Lineage Reconciliation V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "public_branch_parent",
    "source_sibling",
    "relation",
    "lineage_convergence",
    "laws",
    "truth_effect",
    "evidence_effect",
    "authority_effect",
    "reconciliation_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.P37.PublicLineageReconciliation.V1"},
    "public_branch_parent": {
      "type": "object",
      "required": ["result_id", "release_digest", "implementation_commit", "implementation_tree", "release_commit", "release_tree"]
    },
    "source_sibling": {
      "type": "object",
      "required": ["result_id", "result_digest", "source_parent_result_id", "capsule_digest"]
    },
    "relation": {"const": "TYPED_SIBLING_IMPORT"},
    "lineage_convergence": {"const": "NON_COLLAPSING_RECONCILIATION"},
    "laws": {"type": "array", "minItems": 5, "uniqueItems": true},
    "truth_effect": {"const": "NONE"},
    "evidence_effect": {"const": "NONE"},
    "authority_effect": {"const": "NONE"},
    "reconciliation_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
