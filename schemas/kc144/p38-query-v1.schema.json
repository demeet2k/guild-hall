{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.invalid/schemas/p38-query-v1.schema.json",
  "title": "KC144 P38 Dynamic Multi-Crystal Query V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "goal", "crystals"],
  "properties": {
    "schema": {"const": "KC144.P38.Query.V1"},
    "goal": {"type": "string", "minLength": 1},
    "terms": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "crystals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["KC144", "BR21", "KC27", "KC54", "MATH144", "P31", "HEART"]
      }
    },
    "source_surfaces": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
