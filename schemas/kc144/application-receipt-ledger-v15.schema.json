{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/application-receipt-ledger-v15.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transport_id", "batch_id", "batch_root",
    "call_manifest_root", "checked_at", "application_count",
    "admitted_application_count", "held_application_count",
    "duplicate_application_ids", "duplicate_envelope_ids",
    "duplicate_nomination_ids", "duplicate_candidate_ids", "receipts",
    "admitted_v14_envelope_set_root", "publication_effect",
    "authority_effect", "truth_effect", "ledger_root"
  ],
  "properties": {
    "schema": {"const": "KC144.ApplicationReceiptLedger.V15"},
    "transport_id": {
      "const": "KC144.CANDIDATE.APPLICATION.TRANSPORT.V15"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^V11-BATCH::[0-9a-f]{24}$"
    },
    "batch_root": {"$ref": "#/$defs/root"},
    "call_manifest_root": {"$ref": "#/$defs/root"},
    "checked_at": {"type": "string", "minLength": 1},
    "application_count": {"type": "integer", "minimum": 0},
    "admitted_application_count": {"type": "integer", "minimum": 0},
    "held_application_count": {"type": "integer", "minimum": 0},
    "duplicate_application_ids": {"type": "array", "uniqueItems": true},
    "duplicate_envelope_ids": {"type": "array", "uniqueItems": true},
    "duplicate_nomination_ids": {"type": "array", "uniqueItems": true},
    "duplicate_candidate_ids": {"type": "array", "uniqueItems": true},
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "application_id", "envelope_id", "nomination_id",
          "candidate_id", "target_roles", "verification_digest",
          "application_verdict", "duplicate_collision",
          "routing_verdict", "status", "authority_effect",
          "receipt_digest"
        ],
        "properties": {
          "application_id": {"type": "string", "minLength": 1},
          "envelope_id": {"type": "string", "minLength": 1},
          "nomination_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "target_roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "uniqueItems": true
          },
          "verification_digest": {"$ref": "#/$defs/root"},
          "application_verdict": {"enum": ["PASS", "HOLD"]},
          "duplicate_collision": {"type": "boolean"},
          "routing_verdict": {"enum": ["PASS", "HOLD"]},
          "status": {
            "enum": [
              "INNER_V14_ENVELOPE_RELEASED",
              "PRESERVED_NONCOUNTING_APPLICATION"
            ]
          },
          "authority_effect": {"const": "NONE"},
          "receipt_digest": {"$ref": "#/$defs/root"}
        }
      }
    },
    "admitted_v14_envelope_set_root": {"$ref": "#/$defs/root"},
    "publication_effect": {"const": "NONE"},
    "authority_effect": {"const": "NONE"},
    "truth_effect": {"const": "NONE"},
    "ledger_root": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
