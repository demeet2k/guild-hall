{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.invalid/schemas/p38-held-out-outcome-v1.schema.json",
  "title": "KC144 P38 Held-Out Outcome V1",
  "type": "object",
  "required": [
    "schema",
    "outcome_class",
    "origin_class",
    "observed_at",
    "source_surface",
    "source_commitment",
    "route_id",
    "partition",
    "metric",
    "value",
    "consent_scope",
    "source_verified",
    "route_generated",
    "truth_effect",
    "authority_effect",
    "outcome_id",
    "signature"
  ],
  "properties": {
    "schema": {"const": "KC144.P38.HeldOutOutcome.V1"},
    "outcome_class": {"enum": ["TASK_OUTCOME", "EMPIRICAL_RESULT"]},
    "origin_class": {"enum": ["PRODUCTION", "USER_OBSERVED", "CONNECTOR_OBSERVED"]},
    "observed_at": {"type": "string"},
    "source_surface": {"type": "string", "minLength": 1},
    "source_commitment": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "route_id": {"type": "string", "minLength": 1},
    "partition": {"const": "HELD_OUT"},
    "metric": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "consent_scope": {"type": "array", "uniqueItems": true},
    "source_verified": {"const": true},
    "route_generated": {"const": false},
    "truth_effect": {"const": "NONE"},
    "authority_effect": {"const": "NONE"},
    "outcome_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"oneOf": [{"type": "null"}, {"type": "object"}]}
  }
}
