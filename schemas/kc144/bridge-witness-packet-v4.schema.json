{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/bridge-witness-packet-v4.schema.json",
  "title": "KC144 beta bridge-witness packet",
  "type": "object",
  "required": [
    "packet_id",
    "bridge_id",
    "source",
    "target",
    "transport",
    "preserved_invariants",
    "declared_loss",
    "corridor",
    "return_path",
    "attestations"
  ],
  "additionalProperties": false,
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "bridge_id": {"type": "string", "pattern": "^BR[0-9]{3}$"},
    "source": {"type": "integer", "minimum": 1, "maximum": 144},
    "target": {"type": "integer", "minimum": 1, "maximum": 144},
    "transport": {"type": "string", "minLength": 1},
    "preserved_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "declared_loss": {"type": "string", "minLength": 1},
    "corridor": {"type": "string", "minLength": 1},
    "return_path": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "integer", "minimum": 1, "maximum": 144}
    },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "witness_id",
          "evidence_root",
          "author_id",
          "verifier_id",
          "replay_class",
          "signature_status",
          "authority"
        ],
        "additionalProperties": false,
        "properties": {
          "witness_id": {"type": "string", "minLength": 1},
          "evidence_root": {"type": "string", "minLength": 1},
          "author_id": {"type": "string", "minLength": 1},
          "verifier_id": {"type": "string", "minLength": 1},
          "replay_class": {"enum": ["B0", "B1", "B2", "B3", "B4"]},
          "signature_status": {
            "enum": ["UNVERIFIED", "INVALID", "VERIFIED"]
          },
          "authority": {"type": "boolean"}
        }
      }
    }
  }
}
