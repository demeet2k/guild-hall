{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/application-publication-payload-v15.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "transport_id", "payload_id", "role", "batch_id",
    "batch_root", "call_manifest_root", "call_id", "call_digest",
    "call", "transport_contract_digest", "application_schema",
    "signature_algorithm", "signature_domain", "audience", "content_type",
    "response_instruction", "boundary_claim", "publication_state",
    "external_locator_root", "publication_receipt_root",
    "governance_authority_granted", "truth_effect", "payload_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.ApplicationPublicationPayload.V15"},
    "transport_id": {
      "const": "KC144.CANDIDATE.APPLICATION.TRANSPORT.V15"
    },
    "payload_id": {
      "type": "string",
      "pattern": "^V15-PAYLOAD::[A-Z_]+::[0-9a-f]{16}$"
    },
    "role": {"$ref": "#/$defs/role"},
    "batch_id": {
      "type": "string",
      "pattern": "^V11-BATCH::[0-9a-f]{24}$"
    },
    "batch_root": {"$ref": "#/$defs/root"},
    "call_manifest_root": {"$ref": "#/$defs/root"},
    "call_id": {"type": "string", "minLength": 1},
    "call_digest": {"$ref": "#/$defs/root"},
    "call": {"$ref": "nomination-role-call-v14.schema.json"},
    "transport_contract_digest": {"$ref": "#/$defs/root"},
    "application_schema": {
      "const": "KC144.BatchBoundCandidateApplication.V15"
    },
    "signature_algorithm": {"const": "ED25519"},
    "signature_domain": {
      "const": "KC144.V15.BATCH_BOUND_CANDIDATE_APPLICATION"
    },
    "audience": {"const": "EXTERNAL_INDEPENDENT_CANDIDATE_POOL"},
    "content_type": {
      "const": "application/vnd.kc144.role-call+json"
    },
    "response_instruction": {"type": "string", "minLength": 1},
    "boundary_claim": {
      "const": "PREPARED_PAYLOAD_IS_NOT_PUBLICATION_OR_DELIVERY"
    },
    "publication_state": {"const": "READY_UNPUBLISHED"},
    "external_locator_root": {"type": "null"},
    "publication_receipt_root": {"type": "null"},
    "governance_authority_granted": {"const": false},
    "truth_effect": {"const": "NONE"},
    "payload_digest": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "role": {
      "enum": [
        "CUSTODIAN", "INDEPENDENT_REVIEWER", "REPLAY_WITNESS",
        "SOURCE_AUDITOR", "RETURN_AUDITOR"
      ]
    }
  }
}
