{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/session-spec-v5.schema.json",
  "title": "KC144 multi-query session specification",
  "type": "object",
  "required": ["session_id", "epoch", "queries", "execution_mode"],
  "additionalProperties": false,
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "string", "minLength": 1},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "query-bundle-v4.schema.json"}
    },
    "execution_mode": {"const": "DETERMINISTIC_PARALLEL_BATCH"}
  }
}
