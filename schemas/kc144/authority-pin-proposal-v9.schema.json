{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/authority-pin-proposal-v9.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "proposal_id", "epoch_id", "governance_registry_digest",
    "authority_registry_digest", "issued_at", "expires_at",
    "candidate_proof", "approvals"
  ],
  "properties": {
    "schema": {"const": "KC144.AuthorityPinProposal.V9"},
    "proposal_id": {"type": "string", "minLength": 1},
    "epoch_id": {"const": "EPOCH-B-EIGHT-BLOCK"},
    "governance_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "candidate_proof": {"$ref": "authority-enrollment-proof-v8.schema.json"},
    "approvals": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "signature_b64"],
        "properties": {
          "member_id": {"type": "string", "minLength": 1},
          "signature_b64": {"type": "string", "minLength": 86}
        }
      }
    }
  }
}
