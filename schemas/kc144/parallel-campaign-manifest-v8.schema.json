{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/parallel-campaign-manifest-v8.schema.json",
  "title": "KC144 V8 parallel campaign manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "epoch_id",
    "epoch_census",
    "phases",
    "shards",
    "topology_root",
    "shard_count",
    "packet_count",
    "maximum_parallel_width",
    "packet_binding",
    "hologram",
    "laws",
    "manifest_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.ParallelCampaignManifest.V8"},
    "campaign_id": {"const": "KC144.M12.PARALLEL.CAMPAIGN.V8"},
    "epoch_id": {"const": "EPOCH-B-EIGHT-BLOCK"},
    "epoch_census": {"const": "6+16+21+37+10+15+27+12"},
    "phases": {
      "const": ["A_FRONTIER", "B_DEFECT", "C_PROMOTION"]
    },
    "shards": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shard_id",
          "phase",
          "evidence_kind",
          "coordinate",
          "subject_ids",
          "packet_count",
          "dependencies",
          "execution",
          "atomicity"
        ],
        "properties": {
          "shard_id": {"type": "string", "minLength": 1},
          "phase": {
            "enum": ["A_FRONTIER", "B_DEFECT", "C_PROMOTION"]
          },
          "evidence_kind": {
            "enum": [
              "BRIDGE_CERTIFICATION",
              "DOMAIN_POPULATION",
              "INDEPENDENT_REPLAY",
              "DEFECT_CLOSURE",
              "IC10_PROMOTION"
            ]
          },
          "coordinate": {"type": "string", "minLength": 1},
          "subject_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "packet_count": {"type": "integer", "minimum": 1},
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "execution": {
            "enum": ["PARALLEL_READY_SUBGRAPH", "DEPENDENCY_BOUND"]
          },
          "atomicity": {"const": "SHARD_ENVELOPE_ALL_PACKETS_OR_NONE"}
        }
      }
    },
    "topology_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "shard_count": {"const": 16},
    "packet_count": {"const": 232},
    "maximum_parallel_width": {"const": 14},
    "packet_binding": {"type": "object"},
    "hologram": {"type": "object"},
    "laws": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string", "minLength": 1}
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
