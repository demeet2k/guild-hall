{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/candidate-selection-release-v13.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "release", "parent_release", "verdict",
    "operational_status", "nomination_count", "admitted_candidate_count",
    "solution_status", "selected_cohort", "selected_pairwise_audits",
    "governance_activated", "production_certificate_issued",
    "frozen_crystal_mutated", "added_artifacts", "next_seed",
    "release_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.CandidateSelectionRelease.V13"},
    "release": {"const": "KC144.CANDIDATE.SELECTION.RUNTIME.V13"},
    "parent_release": {"const": "KC144.PARTICIPANT.HANDOFF.RUNTIME.V12"},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "operational_status": {"type": "string", "minLength": 1},
    "nomination_count": {"type": "integer", "minimum": 0},
    "admitted_candidate_count": {"type": "integer", "minimum": 0},
    "solution_status": {"type": "string", "minLength": 1},
    "selected_cohort": {
      "anyOf": [{"type": "null"}, {"type": "object"}]
    },
    "selected_pairwise_audits": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "governance_activated": {"const": false},
    "production_certificate_issued": {"const": false},
    "frozen_crystal_mutated": {"const": false},
    "added_artifacts": {"type": "array", "minItems": 5},
    "next_seed": {"type": "string", "minLength": 1},
    "release_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
