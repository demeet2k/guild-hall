{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/source-harvest-manifest-v9.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "source_id", "source_ref", "content_digest", "acquired_at",
    "provenance_root", "independent", "claims"
  ],
  "properties": {
    "schema": {"const": "KC144.SourceHarvestManifest.V9"},
    "source_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "acquired_at": {"type": "string", "minLength": 1},
    "provenance_root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "independent": {"const": true},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id", "extraction_digest", "relevance_digest", "residual_state"
        ],
        "properties": {
          "subject_id": {"type": "string", "minLength": 1},
          "extraction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "relevance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "residual_state": {
            "enum": [
              "NONE", "VALUE_MISSING", "CARRIER_UNRESOLVED",
              "SEMANTICS_CONTESTED", "SOURCE_INACCESSIBLE",
              "BOUNDARY_UNTESTED", "RETURN_UNVERIFIED", "ORDER_UNTESTED"
            ]
          }
        }
      }
    }
  }
}
