{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athenachka.collective/schemas/kc144/tool-dispatch-request-v1.schema.json",
  "title": "KC144 Tool Dispatch Request V1",
  "type": "object",
  "required": [
    "schema",
    "lookup_query",
    "operation",
    "inputs",
    "input_manifest_digest",
    "start_coordinates",
    "route_budget",
    "allowed_capabilities",
    "allowed_effects",
    "tool_registry_digest",
    "head_registry_digest",
    "production_truth_effect",
    "governance_authority_granted",
    "content_transport_certified",
    "request_id"
  ],
  "properties": {
    "schema": {"const": "KC144.ToolDispatchRequest.V1"},
    "lookup_query": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "input_manifest_digest": {"$ref": "#/$defs/digest"},
    "expected_output_schema": {"type": ["string", "null"]},
    "start_coordinates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 144}
    },
    "route_budget": {"type": "integer", "minimum": 0},
    "allowed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_effects": {
      "const": ["PURE_COMPUTE"]
    },
    "tool_registry_digest": {"$ref": "#/$defs/digest"},
    "head_registry_digest": {"$ref": "#/$defs/digest"},
    "parent_receipt": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "production_truth_effect": {"const": "NONE"},
    "governance_authority_granted": {"const": false},
    "content_transport_certified": {"const": false},
    "request_id": {"$ref": "#/$defs/digest"}
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
