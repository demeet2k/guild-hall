{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/signed-evidence-envelope-v7.schema.json",
  "title": "KC144 V7 signed evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id",
    "namespace",
    "epoch_id",
    "epoch_census",
    "frozen_base_root",
    "crosswalk_digest",
    "graph_slice",
    "graph_slice_digest",
    "issued_at",
    "signer_key_id",
    "packets",
    "signature_b64"
  ],
  "properties": {
    "envelope_id": {"type": "string", "minLength": 1},
    "namespace": {"enum": ["PRODUCTION", "TEST"]},
    "epoch_id": {"const": "EPOCH-B-EIGHT-BLOCK"},
    "epoch_census": {"const": "6+16+21+37+10+15+27+12"},
    "frozen_base_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "crosswalk_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "graph_slice": {
      "enum": ["X16_SCHEDULE", "X16_ALGEBRA", "X16_MULTIPLEX"]
    },
    "graph_slice_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "issued_at": {"type": "string", "minLength": 1},
    "signer_key_id": {"type": "string", "minLength": 1},
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "m12-evidence-packet-v6.schema.json"
      }
    },
    "signature_b64": {"type": "string", "minLength": 86}
  }
}
