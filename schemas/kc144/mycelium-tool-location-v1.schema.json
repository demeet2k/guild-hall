{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/mycelium-tool-location-v1.schema.json",
  "title": "KC144 mycelium tool location receipt",
  "type": "object",
  "required": [
    "schema", "query", "resolved_lookup_key", "status", "resolution",
    "start_coordinates", "route_budget", "coordinate_routes", "commands",
    "base_graph_mutated", "content_transport_certified",
    "governance_authority_granted", "production_truth_effect",
    "location_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.MyceliumToolLocation.V1"},
    "query": {"type": "string", "minLength": 1},
    "resolved_lookup_key": {
      "type": ["string", "null"]
    },
    "status": {"enum": ["FOUND", "NOT_FOUND", "AMBIGUOUS"]},
    "resolution": {"enum": ["EXACT_LOOKUP_KEY", "EXACT_ALIAS", "NONE"]},
    "descriptor_digest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "start_coordinates": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 144}
    },
    "route_budget": {"type": "integer", "minimum": 0},
    "coordinate_routes": {"type": "array"},
    "commands": {"type": "object"},
    "base_graph_mutated": {"const": false},
    "content_transport_certified": {"const": false},
    "governance_authority_granted": {"const": false},
    "production_truth_effect": {"const": "NONE"},
    "location_digest": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "FOUND"}}},
      "then": {"required": ["descriptor_digest"]}
    }
  ]
}
