{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/governance-dispatch-plan-v11.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "dispatch_id", "parent_ceremony_id",
    "dispatch_contract_digest", "authority_registry_digest",
    "handoff_bundle_root", "batch_id", "batch_root", "status", "barrier",
    "next_seed", "parallelism", "governance_activated", "truth_effect",
    "plan_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.GovernanceDispatchPlan.V11"},
    "dispatch_id": {"const": "KC144.GOVERNANCE.DISPATCH.V11"},
    "parent_ceremony_id": {"const": "KC144.GOVERNANCE.CEREMONY.V10"},
    "dispatch_contract_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authority_registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "handoff_bundle_root": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "batch_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^V11-BATCH::[0-9a-f]{24}$"}
      ]
    },
    "batch_root": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      ]
    },
    "status": {"type": "string", "minLength": 1},
    "barrier": {"type": "string", "minLength": 1},
    "next_seed": {"type": "string", "minLength": 1},
    "parallelism": {
      "const": "ALL_FIVE_ROLE_RESPONSES_ROUTE_IN_ONE_WAVE"
    },
    "governance_activated": {"const": false},
    "truth_effect": {"const": "NONE"},
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
