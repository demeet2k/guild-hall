{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kc144.local/schemas/graph-slice-registry-v7.schema.json",
  "title": "KC144 V7 graph slice registry",
  "type": "object",
  "required": [
    "schema",
    "active_frozen_slice",
    "maximum_union_slice",
    "slices",
    "laws",
    "registry_digest"
  ],
  "properties": {
    "schema": {"const": "KC144.GraphSliceRegistry.V7"},
    "active_frozen_slice": {"const": "X16_ALGEBRA"},
    "maximum_union_slice": {"const": "X16_MULTIPLEX"},
    "slices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "slice_id",
          "x16_reading",
          "relation_record_count",
          "structural_relation_records",
          "declared_bridge_records",
          "distinct_adjacency_count",
          "relation_census",
          "records_digest",
          "truth_effect",
          "slice_digest"
        ]
      }
    },
    "laws": {"type": "array", "minItems": 1},
    "registry_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
