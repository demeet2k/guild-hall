{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athenachka.local/schemas/reentry-permit.schema.json",
  "title": "ReentryPermit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "permit_id",
    "cycle_id",
    "repaired_act_id",
    "contradiction_packet_refs",
    "repair_receipt_refs",
    "trust_revision_refs",
    "replay_receipt_ref",
    "witness_root",
    "ic10_gate_vector",
    "ic10_overall",
    "omega_gate",
    "sigma_gate",
    "blocking_residuals",
    "admission_class",
    "reentry_allowed",
    "separation_of_roles_pass",
    "packet_hash"
  ],
  "properties": {
    "schema_version": {"const": "REENTRY_PERMIT/1"},
    "permit_id": {"type": "string", "minLength": 1},
    "cycle_id": {"type": "string", "minLength": 1},
    "repaired_act_id": {"type": "string", "minLength": 1},
    "contradiction_packet_refs": {"type": "array", "items": {"type": "string"}},
    "repair_receipt_refs": {"type": "array", "items": {"type": "string"}},
    "trust_revision_refs": {"type": "array", "items": {"type": "string"}},
    "replay_receipt_ref": {"type": "string"},
    "witness_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ic10_gate_vector": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {"enum": ["PASS", "NEAR", "HOLD", "FAIL"]}
    },
    "ic10_overall": {"enum": ["PASS", "NEAR", "HOLD", "FAIL"]},
    "omega_gate": {"enum": ["PASS", "FAIL"]},
    "sigma_gate": {"enum": ["PASS", "FAIL"]},
    "unresolved_residuals": {"type": "array", "items": {"type": "string"}},
    "blocking_residuals": {"type": "array", "items": {"type": "string"}},
    "admitted_scope": {"type": "array", "items": {"type": "string"}},
    "excluded_scope": {"type": "array", "items": {"type": "string"}},
    "allowed_operations": {"type": "array", "items": {"type": "string"}},
    "forbidden_operations": {"type": "array", "items": {"type": "string"}},
    "admission_class": {
      "enum": ["FULL", "LIMITED", "DEFERRED", "QUARANTINED", "REFUSED"]
    },
    "reentry_allowed": {"type": "boolean"},
    "decision_reasons": {"type": "array", "items": {"type": "string"}},
    "expiry_condition": {"type": "string"},
    "revocation_conditions": {"type": "array", "items": {"type": "string"}},
    "immune_steward": {"type": "string"},
    "replay_auditor": {"type": "string"},
    "meta_observer": {"type": "string"},
    "separation_of_roles_pass": {"type": "boolean"},
    "successor_seed_ref": {"type": ["string", "null"]},
    "prior_permit_hash": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "packet_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

